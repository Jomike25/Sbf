<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Frage 3 / 20" />

        <TextView
            android:id="@+id/textCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_flame"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/flame_500"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="🔥 3"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/navy_700"
            android:textSize="13sp"
            tools:text="7 ✓" />

        <ImageButton
            android:id="@+id/buttonSound"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quiz_sound_content_description"
            android:src="@drawable/ic_volume_on" />

        <ImageButton
            android:id="@+id/buttonMark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quiz_mark_content_description"
            android:src="@drawable/ic_star_outline" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressQuiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_quiz"
        tools:progress="30" />

    <ScrollView
        android:id="@+id/scrollQuiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="Welche Seite wird als Luvseite bezeichnet?" />

            <ImageView
                android:id="@+id/imageQuestion"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/quiz_question_image_content_description"
                tools:src="@drawable/ic_star_filled" />

            <TextView
                android:id="@+id/textImageHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/quiz_image_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerJokers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonHint"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/quiz_hint_button"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textWagerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quiz_wager_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupWager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWager10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/quiz_wager_option_10"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWager20"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/quiz_wager_option_20"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWager50"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/quiz_wager_option_50"
                    android:textSize="12sp" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/textWagerActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/flame_500"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Einsatz aktiv: 20 XP – richtig: +20 XP Bonus, falsch: -20 XP"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/optionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="A) Die dem Wind zugekehrte Seite." />

            <TextView
                android:id="@+id/optionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="B) Option" />

            <TextView
                android:id="@+id/optionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="C) Option" />

            <TextView
                android:id="@+id/optionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="D) Option" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/textFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_feedback_correct"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Richtig! +12 XP"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonExplain"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/quiz_explain_button"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/containerExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textExplainCorrect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/green_correct"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Richtige Antwort: Die dem Wind zugekehrte Seite." />

        <TextView
            android:id="@+id/textExplainWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Luv ist die dem Wind zugewandte Seite, Lee die windabgewandte Seite ..." />

        <TextView
            android:id="@+id/textExplainMnemonic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/amber_700"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="💡 Merkhilfe: ..."
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/navy_700"
        android:enabled="false"
        android:text="@string/quiz_next" />

</LinearLayout>
